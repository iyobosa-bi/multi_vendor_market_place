* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore


* text=auto eol=lf

# Reduce noise from vendor/template assets
/public/admin/dist/**  linguist-vendored=true
/public/admin/static/** linguist-vendored=true
/vendor/**             linguist-vendored=true

# Force PHP to dominate
*.php linguist-detectable=true
*.php linguist-language=PHP
